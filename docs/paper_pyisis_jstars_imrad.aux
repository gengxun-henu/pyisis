\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {III-C}}Adaptive Routing System}{6}{subsection.3.3}\protected@file@percent }
\newlabel{sec:adaptive_routing}{{\mbox  {III-C}}{6}{Adaptive Routing System}{subsection.3.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {III-C}1}Texture Sparseness Quantification}{6}{subsubsection.3.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Adaptive routing system workflow. Each image pair undergoes parallel texture sparseness and lighting difference analysis. Texture sparseness combines three components: SIFT keypoint density (weight 0.45), gradient magnitude (0.30), and GLCM contrast (0.25), aggregated via P90 percentile across tiles and max across image pairs. Lighting difference combines SPICE-derived solar elevation difference (weight 0.4) and azimuth difference (weight 0.6). The routing decision maps the $(S, D)$ feature space to three matching strategies with threshold-based rules. Quality gate evaluation determines whether to accept the match or trigger cascade fallback (SIFT $\rightarrow $ LightGlue $\rightarrow $ LoFTR). Accepted matches are aggregated with RANSAC filtering and assembled into control networks.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:adaptive_routing}{{2}{6}{Adaptive routing system workflow. Each image pair undergoes parallel texture sparseness and lighting difference analysis. Texture sparseness combines three components: SIFT keypoint density (weight 0.45), gradient magnitude (0.30), and GLCM contrast (0.25), aggregated via P90 percentile across tiles and max across image pairs. Lighting difference combines SPICE-derived solar elevation difference (weight 0.4) and azimuth difference (weight 0.6). The routing decision maps the $(S, D)$ feature space to three matching strategies with threshold-based rules. Quality gate evaluation determines whether to accept the match or trigger cascade fallback (SIFT $\rightarrow $ LightGlue $\rightarrow $ LoFTR). Accepted matches are aggregated with RANSAC filtering and assembled into control networks}{figure.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {III-C}2}Lighting Difference Quantification}{7}{subsubsection.3.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {III-C}3}Routing Rules and Cascade Fallback}{7}{subsubsection.3.3.3}\protected@file@percent }
