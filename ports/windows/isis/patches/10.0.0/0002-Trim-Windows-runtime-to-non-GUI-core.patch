From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gengxun-henu <gengxun@henu.edu.cn>
Date: Fri, 24 Jul 2026 09:00:00 +0800
Subject: [PATCH] Trim Windows runtime to non-GUI core

Keep the MSVC ISIS runtime focused on the object libraries consumed by the
standalone bindings. Building every application implementation into one
export-all DLL exceeds the 65,535-member MSVC import-library limit. Exclude the
qisis module and the unbound BundleAdjust implementation while keeping the
bound BundleSolutionInfo data/statistics API. Its Project serialization paths
are not exposed by the standalone bindings and depend on qisis, so omit those
paths only on MSVC. Linux and other upstream builds retain their existing
source selection and behavior.
---
 isis/cmake/AddIsisModule.cmake                     |  6 +++++-
 isis/src/CMakeLists.txt                            | 10 +++++++++-
 .../objs/BundleSolutionInfo/BundleSolutionInfo.cpp | 17 +++++++++++++++++
 3 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/isis/cmake/AddIsisModule.cmake b/isis/cmake/AddIsisModule.cmake
index b7615f2df..b86714ac9 100644
--- a/isis/cmake/AddIsisModule.cmake
+++ b/isis/cmake/AddIsisModule.cmake
@@ -219,3 +219,7 @@ function(add_isis_module name)
     # Start with the objs folder
     get_subdirectory_list(${objsDir} thisObjFolders)
-    get_subdirectory_list(${appsDir} thisAppFolders)
+    if(MSVC)
+      set(thisAppFolders)
+    else()
+      get_subdirectory_list(${appsDir} thisAppFolders)
+    endif()
diff --git a/isis/src/CMakeLists.txt b/isis/src/CMakeLists.txt
index 475a3291a..4989f0a85 100644
--- a/isis/src/CMakeLists.txt
+++ b/isis/src/CMakeLists.txt
@@ -1,2 +1,7 @@
 #===============================================================================
-set(CORE_LIST base database control qisis system socet dev)
+if(MSVC)
+  set(CORE_LIST base database control system socet dev)
+  list(APPEND ISIS_DISABLED_OBJ_FOLDERS BundleAdjust)
+else()
+  set(CORE_LIST base database control qisis system socet dev)
+endif()
@@ -17,1 +22,4 @@ foreach(core ${CORE_LIST})
 list(REMOVE_ITEM modules "${CMAKE_CURRENT_LIST_DIR}/core")
+if(MSVC)
+  list(REMOVE_ITEM modules "${CMAKE_CURRENT_LIST_DIR}/qisis")
+endif()
diff --git a/isis/src/control/objs/BundleSolutionInfo/BundleSolutionInfo.cpp b/isis/src/control/objs/BundleSolutionInfo/BundleSolutionInfo.cpp
index c20009c86..3d5683f3e 100755
--- a/isis/src/control/objs/BundleSolutionInfo/BundleSolutionInfo.cpp
+++ b/isis/src/control/objs/BundleSolutionInfo/BundleSolutionInfo.cpp
@@ -132,4 +132,6 @@ namespace Isis {
     QString projectRoot;
+#if !defined(_MSC_VER)
     if (m_xmlHandlerProject) {
       projectRoot = m_xmlHandlerProject->projectRoot() + "/";
     }
+#endif
@@ -300,1 +302,4 @@ namespace Isis {
+#if defined(_MSC_VER)
+    (void) project;
+#else
     //TODO do we need to close anything here?
@@ -315,1 +320,2 @@ namespace Isis {
     m_outputControlName = newOutputFileName.expanded();
+#endif
@@ -389,4 +395,8 @@ namespace Isis {
+#if defined(_MSC_VER)
+    return m_outputControlName;
+#else
     if (m_outputControl)
       return m_outputControl->fileName();
     else
       return m_outputControlName;
+#endif
@@ -2001,1 +2011,6 @@ namespace Isis {
+#if defined(_MSC_VER)
+    (void) stream;
+    (void) project;
+    (void) newProjectRoot;
+#else
     // This is done for testing serialization without a Project
@@ -2116,1 +2131,2 @@ namespace Isis {
     stream.writeEndElement(); //end bundleSolutionInfo
+#endif
-- 
