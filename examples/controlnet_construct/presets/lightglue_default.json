{
  "feature_extractor": {
    "method": "superpoint",
    "max_keypoints": 4096,
    "keypoint_threshold": 0.0005,
    "remove_borders": 4,
    "detect_keypoints": true
  },
  "matcher": {
    "method": "lightglue",
    "weights": "superpoint_lightglue",
    "weights_path": null,
    "flash": true,
    "prune_threshold": 4
  },
  "device": {
    "prefer_gpu": true,
    "dtype": "float32",
    "batch_inference": true
  },
  "fallback": {
    "on_error": "sift_flann"
  }
}
