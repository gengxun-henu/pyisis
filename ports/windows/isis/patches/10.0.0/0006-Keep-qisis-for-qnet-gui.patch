From 2222222222222222222222222222222222222222 Mon Sep 17 00:00:00 2001
From: gengxun-henu <gengxun@henu.edu.cn>
Date: Wed, 7 Oct 2026 03:30:00 +0800
Subject: [PATCH] Build qisis as a separate Windows GUI module

Keep the qisis module out of the monolithic ISIS core DLL on MSVC. When qnet
is explicitly allowlisted, leave qisis in the module traversal so ISIS builds
qisis.dll separately and links qnet against both module libraries. Other
Windows builds continue to omit qisis entirely.

---
 isis/src/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/isis/src/CMakeLists.txt b/isis/src/CMakeLists.txt
index 4989f0a85..b1e7f0b16 100644
--- a/isis/src/CMakeLists.txt
+++ b/isis/src/CMakeLists.txt
@@ -20,6 +20,6 @@ endforeach(core)
 
 list(REMOVE_ITEM modules "${CMAKE_CURRENT_LIST_DIR}/core")
-if(MSVC)
+if(MSVC AND NOT "qnet" IN_LIST ISIS_WINDOWS_APP_ALLOWLIST)
   list(REMOVE_ITEM modules "${CMAKE_CURRENT_LIST_DIR}/qisis")
 endif()
 
-- 
