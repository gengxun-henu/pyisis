graph LR
    subgraph Scenario1["<b>Scenario 1: Texture-Rich Terrain</b><br/>(S < 0.35, D < 0.20)"]
        direction TB
        S1_SIFT["SIFT/BF<br/>✓ 85% success<br/>45 inliers/tile"]
        S1_LG["LightGlue<br/>✓ 88% success<br/>52 inliers/tile"]
        S1_LoFTR["LoFTR<br/>✓ 82% success<br/>Semi-dense"]
    end

    subgraph Scenario2["<b>Scenario 2: Texture-Poor Terrain</b><br/>(S > 0.65)"]
        direction TB
        S2_SIFT["SIFT/BF<br/>✗ 15% success<br/>8 inliers/tile"]
        S2_LG["LightGlue<br/>△ 45% success<br/>18 inliers/tile"]
        S2_LoFTR["LoFTR<br/>✓ 62% success<br/>Semi-dense"]
    end

    subgraph Scenario3["<b>Scenario 3: High Illumination Difference</b><br/>(D > 0.55)"]
        direction TB
        S3_SIFT["SIFT/BF<br/>✗ 8% success<br/>5 inliers/tile"]
        S3_LG["LightGlue<br/>△ 38% success<br/>15 inliers/tile"]
        S3_LoFTR["LoFTR<br/>✓ 58% success<br/>Semi-dense"]
    end

    Scenario1 --> Route1["<b>Routing:</b><br/>SIFT/BF<br/><i>Fast classical</i>"]
    Scenario2 --> Route2["<b>Routing:</b><br/>LoFTR<br/><i>Detector-free</i>"]
    Scenario3 --> Route3["<b>Routing:</b><br/>LoFTR<br/><i>Illumination-robust</i>"]

    classDef success fill:#2ca02c,stroke:#000,stroke-width:2px,color:#fff,font-weight:bold
    classDef partial fill:#ff7f0e,stroke:#000,stroke-width:2px,color:#fff
    classDef fail fill:#d62728,stroke:#000,stroke-width:2px,color:#fff
    classDef route fill:#9467bd,stroke:#000,stroke-width:2px,color:#fff,font-weight:bold

    class S1_SIFT,S1_LG,S1_LoFTR,S2_LoFTR,S3_LoFTR success
    class S2_LG,S3_LG partial
    class S2_SIFT,S3_SIFT fail
    class Route1,Route2,Route3 route

    style Scenario1 fill:#e6ffe6,stroke:#2ca02c,stroke-width:2px
    style Scenario2 fill:#fff0e6,stroke:#ff7f0e,stroke-width:2px
    style Scenario3 fill:#ffe6e6,stroke:#d62728,stroke-width:2px
