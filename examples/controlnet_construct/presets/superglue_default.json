{
  "feature_extractor": {
    "method": "superpoint",
    "max_keypoints": 4096,
    "keypoint_threshold": 0.0005,
    "remove_borders": 4,
    "detect_keypoints": true
  },
  "matcher": {
    "method": "superglue",
    "weights": "outdoor",
    "weights_path": null,
    "sinkhorn_iterations": 20,
    "match_threshold": 0.2
  },
  "device": {
    "prefer_gpu": true,
    "dtype": "float32",
    "batch_inference": false
  },
  "fallback": {
    "on_error": "sift_bf"
  }
}
