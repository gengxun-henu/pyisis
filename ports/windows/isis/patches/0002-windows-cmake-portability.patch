+function(add_glob_copy_target targetName destination)
+  file(MAKE_DIRECTORY ${destination})
+  file(GLOB copyFiles ${ARGN})
+  if(copyFiles)
+    file(COPY ${copyFiles} DESTINATION ${destination})
+  endif()
+  add_custom_target(${targetName} ALL
+    COMMAND ${CMAKE_COMMAND} -E make_directory ${destination}
+    VERBATIM)
+endfunction()
 
